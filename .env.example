# Postgres connection string (Neon, Supabase, or Vercel's Postgres marketplace integration).
# Include ?sslmode=require for hosted providers.
DATABASE_URL="postgres://user:password@host:5432/tickd"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
# Only used for Next's metadata API (og:image/canonical URL resolution);
# Auth.js itself derives its redirect/cookie host from the incoming
# request automatically (trusted by default in dev and on Vercel) - no
# AUTH_URL/NEXTAUTH_URL needed, and setting one to a stale value is a good
# way to break sign-in when it drifts out of sync with how the app is
# actually being served.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth0 hosted login is off by default: unauthenticated visitors instead
# pick a display name to join, no password/email/OAuth required. Set this
# to "true" and fill in the AUTH0_* vars below to require Auth0 sign-in.
AUTH0_ENABLED="false"

# Auth0 application (Regular Web Application), only needed when
# AUTH0_ENABLED="true". Sign-in redirects straight to Auth0's hosted
# Universal Login - enable whichever connections (Google, email/password,
# passwordless, etc.) you want offered there.
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="..."
AUTH0_CLIENT_SECRET="..."
AUTH0_ISSUER="https://your-tenant.us.auth0.com"

# Push notifications (evening nudge, weekly recap). Optional - the app
# works fine with these unset, the toggles in /account just won't
# actually deliver anything. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY must also be exposed to the client (that's what
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is for) so pushManager.subscribe() can use
# it - VAPID_PRIVATE_KEY stays server-only.
VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
NEXT_PUBLIC_VAPID_PUBLIC_KEY="same value as VAPID_PUBLIC_KEY"
VAPID_SUBJECT="mailto:you@example.com"

# Sent as `Authorization: Bearer <value>` by whatever calls the cron
# routes - set this so they reject anyone else calling them. Optional
# locally: unset, the routes skip the check entirely so you can hit them
# directly while testing.
#
# The routes need to run hourly (see their own comments for why), which
# Vercel's own Cron feature can't do on the Hobby plan (once-a-day only)
# and GitHub Actions isn't used for either (keeps that usage for CI) - an
# Upstash QStash schedule calls them instead. See the README's
# "Notification cron" section for the one-time setup; set this same value
# as the Vercel project's CRON_SECRET env var too, or QStash's calls will
# 401.
CRON_SECRET="generate with: openssl rand -hex 32"
