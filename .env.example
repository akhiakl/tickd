# Postgres connection string (Neon, Supabase, or Vercel's Postgres marketplace integration).
# Include ?sslmode=require for hosted providers.
DATABASE_URL="postgres://user:password@host:5432/tickd"

# Auth.js
AUTH_SECRET="generate with: npx auth secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth0 application (Regular Web Application). Sign-in redirects straight to
# Auth0's hosted Universal Login - enable whichever connections (Google,
# email/password, passwordless, etc.) you want offered there.
AUTH0_DOMAIN="your-tenant.us.auth0.com"
AUTH0_CLIENT_ID="..."
AUTH0_CLIENT_SECRET="..."
AUTH0_ISSUER="https://your-tenant.us.auth0.com"
